      { "id": "risk_governor", "title": "Risk Governor", "domains": ["risk", "policy", "human-gates"], "capabilities": ["risk_governance"], "toolPermissions": ["read_only", "write_reversible"], "defaultRisk": "yellow", "riskCeiling": "yellow", "defaultModelClass": "review", "evaluationSuiteRefs": ["vitest:apps/web/tests/alpha2-agent-fleet.contract.test.ts"] },
      { "id": "product_agent", "title": "Product Agent", "domains": ["product", "journey", "requirements"], "capabilities": ["product_analysis"], "toolPermissions": ["read_only", "write_reversible"], "defaultRisk": "green", "riskCeiling": "green", "defaultModelClass": "reasoning", "evaluationSuiteRefs": ["vitest:apps/web/tests/alpha2-agent-fleet.contract.test.ts"] },
      { "id": "engineering_agent", "title": "Engineering Agent", "domains": ["code", "refactoring", "repository"], "capabilities": ["engineering"], "toolPermissions": ["read_only", "write_reversible"], "defaultRisk": "yellow", "riskCeiling": "yellow", "defaultModelClass": "engineering", "evaluationSuiteRefs": ["vitest:apps/web/tests/alpha2-agent-fleet.contract.test.ts", "vitest:apps/web/tests/alpha2-review-auth-boundary.contract.test.ts"] },
      { "id": "review_agent", "title": "Independent Review Agent", "domains": ["code-review", "architecture-review"], "capabilities": ["independent_review"], "toolPermissions": ["read_only", "write_reversible"], "defaultRisk": "green", "riskCeiling": "green", "defaultModelClass": "review", "evaluationSuiteRefs": ["vitest:apps/web/tests/alpha2-agent-fleet.contract.test.ts", "vitest:apps/web/tests/alpha2-review-auth-boundary.contract.test.ts"] },
