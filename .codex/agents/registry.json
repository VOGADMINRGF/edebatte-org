      { "id": "chief_critic", "title": "Chief Critic", "domains": ["adversarial-review", "priority-challenge"], "capabilities": ["critique"], "toolPermissions": ["read_only", "write_reversible"], "defaultRisk": "green", "riskCeiling": "green", "defaultModelClass": "review", "evaluationSuiteRefs": ["vitest:apps/web/tests/alpha2-agent-fleet.contract.test.ts"] },
