# eDebatte B2C Stripe billing
# Keep secrets in the deployment secret manager; never commit real values.
STRIPE_SECRET_KEY=__set_in_secret_manager__
STRIPE_WEBHOOK_SECRET=__set_in_secret_manager__

# Public canonical origin used for Stripe success/cancel and portal return URLs.
PUBLIC_BASE_URL=https://edebatte.org
NEXT_PUBLIC_BASE_URL=https://edebatte.org

# Live Stripe price lookup keys expected by the server integration:
# edebatte_plus_monthly -> 7.99 EUR/month
# edebatte_pro_monthly  -> 19.99 EUR/month
