# APP
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AUTH / SECURITY
JWT_SECRET=__set_in_secret_manager__
BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=7
EDITOR_TOKEN=__set_in_secret_manager__
FEEDS_PULL_CONCURRENCY=4
FEEDS_PULL_TIMEOUT_MS=12000

# EMAIL
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="eDebatte <members@edebatte.org>"
MAIL_REPLY_TO="eDebatte Team <members@edebatte.org>"
# Optional authenticated SMTP in production:
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Alternative full SMTP transport URL; when set it takes precedence over host/port/auth.
SMTP_URL=
# Optional recipient-domain allowlist for controlled test sends.
MAIL_ALLOWED_RECIPIENT_DOMAINS=
# Legacy alias during migration only:
# SMTP_FROM="eDebatte <members@edebatte.org>"

# PERSONALIZED NEWSLETTER / USER NOTIFICATIONS
# Required for Vercel Cron authorization. Use a random secret with at least 16 characters.
CRON_SECRET=__set_in_secret_manager__
# Required for signed human + RFC 8058 one-click unsubscribe URLs.
NEWSLETTER_UNSUBSCRIBE_SECRET=__set_in_secret_manager__
# Must match the consent version written by the public updates DOI flow.
UPDATES_CONSENT_VERSION=updates_v1
# Candidate freshness and bounded batch/retry lifecycle.
NEWSLETTER_CANDIDATE_MAX_AGE_DAYS=21
NEWSLETTER_BATCH_SIZE=100
NEWSLETTER_SEND_CONCURRENCY=4
NEWSLETTER_MAX_ATTEMPTS=4
NEWSLETTER_RETRY_BASE_MINUTES=15
NEWSLETTER_LEDGER_RETENTION_DAYS=180

# OPS STATUS REPORT (internal)
STATUS_REPORT_ENABLED=false
STATUS_REPORT_RECIPIENTS=rgf@voiceopengov.de
STATUS_REPORT_TZ=Europe/Berlin
STATUS_REPORT_SUBJECT_PREFIX="[eDebatte Ops]"
STATUS_REPORT_INCLUDE_AI_SMOKES=true
STATUS_REPORT_SLOT_GRACE_MINUTES=20
STATUS_REPORT_SLOTS=05:00,17:00
STATUS_REPORT_BASE_URL=http://127.0.0.1:3000
STATUS_REPORT_INTERNAL_TRIGGER_SECRET=__set_for_production__

# FACTCHECK / SPLITTER
CLAIM_SPLITTER=internal
CLAIM_SPLITTER_URL=http://nlp:8080/split
CLAIM_SPLITTER_TOKEN=__optional_token__

# POSTGRES
WEB_DATABASE_URL=postgresql://dev:devpassword@localhost:5433/vog?schema=public
WEB_POSTGRES_URL=${WEB_DATABASE_URL}
WEB_POSTGRES_URI=${WEB_DATABASE_URL}
# The web runtime ignores DATABASE_URL on purpose to avoid foreign DSNs.

# MONGODB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vpm25
CORE_DB_NAME=core_prod
CORE_MONGODB_URI=__set_in_secret_manager__
VOTES_DB_NAME=votes_prod
VOTES_MONGODB_URI=__set_in_secret_manager__
PII_DB_NAME=pii_prod
PII_MONGODB_URI=__set_in_secret_manager__
AI_CORE_READER_DB_NAME=core_prod
AI_CORE_READER_MONGODB_URI=__set_in_secret_manager__
PUBLIC_ID_SALT=__set_in_secret_manager__

# GRAPH
GRAPH_PRIMARY=neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__set_in_secret_manager__
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_MS=8000
NEO4J_DISABLE_LOSSLESS_INTEGERS=true
ARANGO_URL=http://localhost:8529
ARANGO_DB=vog
ARANGO_USER=root
ARANGO_ROOT_PASSWORD=__set_in_secret_manager__
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=__optional__


# CACHING / STREAMING
KAFKA_BROKERS=localhost:19092
REDIS_URL=redis://127.0.0.1:6379

# AI / PROVIDER
FEATURE_AI_ARBITER=true
FEATURE_TRANSLATION_CACHE=true
PROMPT_VERSION=v1
OPENAI_API_KEY=__set_in_secret_manager__
GEMINI_API_KEY=__set_in_secret_manager__
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=__set_in_secret_manager__
MISTRAL_API_KEY=__set_in_secret_manager__
YOU_API_KEY=__set_in_secret_manager__
