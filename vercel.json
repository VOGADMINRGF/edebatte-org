{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "preview-*": true,
      "preview/**": true
    }
  },
  "crons": [
    { "path": "/api/cron/operator-digest?slot=summer", "schedule": "0 16 * * *" },
    { "path": "/api/cron/operator-digest?slot=winter", "schedule": "0 17 * * *" }
  ]
}
